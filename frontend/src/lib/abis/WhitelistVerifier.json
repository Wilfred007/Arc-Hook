)":"1303a484","lastNonce()":"52631ab4","owner()":"8da5cb5b","proverEOA()":"c1ce6d46","renounceOwnership()":"715018a6","setProverEOA(address)":"9d790eab","transferOwnership(address)":"f2fde38b","updateCommitment(bytes,uint64)":"1fee132a","verify(address,bytes)":"4a41d1ac"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.26+commit.8a97fa7a\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_proverEOA\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[],\"name\":\"InvalidProof\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"}],\"name\":\"OwnableInvalidOwner\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"account\",\"type\":\"address\"}],\"name\":\"OwnableUnauthorizedAccount\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"StaleNonce\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"UnauthorizedProver\",\"type\":\"error\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":false,\"internalType\":\"bytes\",\"name\":\"commitment\",\"type\":\"bytes\"},{\"indexed\":false,\"internalType\":\"uint64\",\"name\":\"nonce\",\"type\":\"uint64\"}],\"name\":\"CommitmentUpdated\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"previousOwner\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"newOwner\",\"type\":\"address\"}],\"name\":\"OwnershipTransferred\",\"type\":\"event\"},{\"inputs\":[],\"name\":\"commitment\",\"outputs\":[{\"internalType\":\"bytes\",\"name\":\"\",\"type\":\"bytes\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"lastNonce\",\"outputs\":[{\"internalType\":\"uint64\",\"name\":\"\",\"type\":\"uint64\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"owner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"proverEOA\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"renounceOwnership\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_proverEOA\",\"type\":\"address\"}],\"name\":\"setProverEOA\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"newOwner\",\"type\":\"address\"}],\"name\":\"transferOwnership\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes\",\"name\":\"_commitment\",\"type\":\"bytes\"},{\"internalType\":\"uint64\",\"name\":\"_nonce\",\"type\":\"uint64\"}],\"name\":\"updateCommitment\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"sender\",\"type\":\"address\"},{\"internalType\":\"bytes\",\"name\":\"hookData\",\"type\":\"bytes\"}],\"name\":\"verify\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"pure\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Proof format (hookData):      abi.encode(uint256 claimedValue, uint256[20] evalPoint, bytes[20] quotientCommitments)      - claimedValue:         must equal 1 (address is whitelisted)      - evalPoint[i]:         bit i of keccak256(abi.encodePacked(sender)), 0 or 1      - quotientCommitments:  n=20 compressed G1 points (48 bytes each), one per                              dimension of the multilinear proofPairing verification (PRODUCTION TODO):      For each dimension i (0..n-1), the verifier must check:        e(Q_i, [\\u03c4]\\u2082 - [z_i]\\u2082) = e(C_{i-1} - C_{i}, [1]\\u2082)      where:        Q_i   = quotientCommitments[i]  (quotient commitment for dimension i)        z_i   = evalPoint[i]            (the i-th coordinate of sender's point)        C_0   = `commitment`            (current stored commitment)        C_i   = running commitment after folding i dimensions        [\\u03c4]\\u2082  = G2 generator scaled by \\u03c4 (from trusted setup)        [1]\\u2082  = G2 generator      This requires the EIP-2537 BLS12-381 precompile (0x0f) for pairing.      Deploy to a network that supports EIP-2537 and implement the check below.\",\"errors\":{\"OwnableInvalidOwner(address)\":[{\"details\":\"The owner is not a valid owner account. (eg. `address(0)`)\"}],\"OwnableUnauthorizedAccount(address)\":[{\"details\":\"The caller account is not authorized to perform an operation.\"}]},\"kind\":\"dev\",\"methods\":{\"owner()\":{\"details\":\"Returns the address of the current owner.\"},\"renounceOwnership()\":{\"details\":\"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner.\"},\"transferOwnership(address)\":{\"details\":\"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner.\"},\"updateCommitment(bytes,uint64)\":{\"details\":\"Called by the off-chain prover after every whitelist change.      Only the registered proverEOA may call this.\",\"params\":{\"_commitment\":\"48-byte compressed G1 point (BLS12-381).\",\"_nonce\":\"Must be strictly greater than lastNonce.\"}},\"verify(address,bytes)\":{\"details\":\"Security note:      In this development version the cryptographic pairing check is OMITTED.      The evalPoint check (which IS implemented) ensures the proof is bound to      the sender address \\u2014 a different address cannot reuse the same evalPoint.      However, without the pairing check, a malicious user could fabricate      quotientCommitments. See the production TODO above for the full check.\",\"params\":{\"hookData\":\"ABI-encoded proof: see contract-level dev comment for format.\",\"sender\":\"The address attempting to swap.\"},\"returns\":{\"_0\":\"True if the evaluation point matches the sender AND claimedValue == 1.\"}}},\"title\":\"WhitelistVerifier\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"commitment()\":{\"notice\":\"The latest KZG commitment to the whitelist polynomial.\"},\"lastNonce()\":{\"notice\":\"Monotonically increasing nonce \\u2014 prevents replay of stale commitments.\"},\"proverEOA()\":{\"notice\":\"The prover EOA authorised to call updateCommitment().\"},\"updateCommitment(bytes,uint64)\":{\"notice\":\"Update the stored KZG commitment.\"},\"verify(address,bytes)\":{\"notice\":\"Verify a KZG membership proof for `sender`.\"}},\"notice\":\"Stores the KZG commitment and verifies membership proofs for the         KZGWhitelistHook. Swappers must prove they are in the whitelist by         providing a valid multilinear KZG opening proof.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/WhitelistVerifier.sol\":\"WhitelistVerifier\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":1000000},\"remappings\":[\":@ensdomains/=lib/v4-periphery/lib/v4-core/node_modules/@ensdomains/\",\":@openzeppelin/=lib/v4-periphery/lib/v4-core/lib/openzeppelin-contracts/\",\":@uniswap/v4-core/=lib/v4-periphery/lib/v4-core/\",\":ds-test/=lib/v4-periphery/lib/v4-core/lib/forge-std/lib/ds-test/src/\",\":erc4626-tests/=lib/v4-periphery/lib/v4-core/lib/openzeppelin-contracts/lib/erc4626-tests/\",\":forge-gas-snapshot/=lib/v4-periphery/lib/permit2/lib/forge-gas-snapshot/src/\",\":forge-std/=lib/forge-std/src/\",\":hardhat/=lib/v4-periphery/lib/v4-core/node_modules/hardhat/\",\":openzeppelin-contracts/=lib/v4-periphery/lib/v4-core/lib/openzeppelin-contracts/\",\":permit2/=lib/v4-periphery/lib/permit2/\",\":solmate/=lib/v4-periphery/lib/v